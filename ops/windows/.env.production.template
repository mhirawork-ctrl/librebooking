# Copy this file to ".env" and set real values before production deployment.
# Do not commit secrets.

COMPOSE_PROJECT_NAME=librebooking
APP_PORT=8080

MARIADB_ROOT_PASSWORD=<set-strong-password>
LB_DATABASE_NAME=librebooking
LB_DATABASE_USER=lb_user
LB_DATABASE_PASSWORD=<set-strong-password>

LB_INSTALL_PASSWORD=<set-strong-install-password>

LB_ADMIN_USERNAME=admin
LB_ADMIN_PASSWORD=<set-admin-password>
LB_ADMIN_FIRST_NAME=System
LB_ADMIN_LAST_NAME=Admin
LB_ADMIN_EMAIL=admin@example.ac.jp
LB_ADMIN_EMAIL_NAME=LB Administrator

LB_APP_TITLE=LibreBooking
LB_COMPANY_NAME=University
LB_COMPANY_URL=https://www.example.ac.jp/

# Set official URL when DNS is issued, for example:
# LB_SCRIPT_URL=https://reserve.example.ac.jp
LB_SCRIPT_URL=http://131.112.159.12:8080

LB_DEFAULT_TIMEZONE=Asia/Tokyo
LB_DEFAULT_LANGUAGE=ja_jp
LB_DEFAULT_HOMEPAGE=2
LB_NAME_FORMAT={last} {first}

LB_CACHE_TEMPLATES=true
LB_USE_LOCAL_JS_LIBS=true

LB_EMAIL_ENABLED=false
LB_REGISTRATION_ALLOW_SELF_REGISTRATION=false
LB_REGISTRATION_CAPTCHA_ENABLED=false
LB_PRIVACY_VIEW_SCHEDULES=false

LB_LOGGING_FOLDER=/var/log/librebooking
LB_LOGGING_LEVEL=INFO
LB_LOGGING_SQL=false
